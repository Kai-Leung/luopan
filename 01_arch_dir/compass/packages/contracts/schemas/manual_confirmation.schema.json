{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ManualConfirmation",
  "description": "Manual confirmation gate between S2 governance and L2 fact entry",
  "type": "object",
  "definitions": {
    "PendingConfirmationCreateRequest": {
      "type": "object",
      "required": ["raw_input_id", "candidate_id", "governance_id", "governance_status", "fact_type", "fact_payload", "display_text"],
      "properties": {
        "raw_input_id": { "type": "string", "description": "Raw input record ID" },
        "input_session_id": { "type": "string", "description": "Input session ID" },
        "candidate_id": { "type": "string", "description": "Candidate record ID" },
        "governance_id": { "type": "string", "description": "Governance check result ID" },
        "governance_status": { "type": "string", "enum": ["auto_pass", "needs_completion", "needs_confirmation", "blocked"] },
        "fact_type": { "type": "string", "description": "Fact record type from candidate" },
        "fact_payload": { "type": "object", "description": "Candidate payload to be confirmed" },
        "display_text": { "type": "string", "description": "Human-readable display for confirmation" },
        "required_permission": { "type": "string" }
      }
    },
    "PendingConfirmationItem": {
      "type": "object",
      "required": ["pending_id", "input_session_id", "raw_input_id", "candidate_id", "governance_id", "governance_status", "fact_type", "fact_payload", "display_text", "created_at"],
      "properties": {
        "pending_id": { "type": "string" },
        "input_session_id": { "type": "string" },
        "raw_input_id": { "type": "string" },
        "candidate_id": { "type": "string" },
        "governance_id": { "type": "string" },
        "governance_status": { "type": "string", "enum": ["auto_pass", "needs_completion", "needs_confirmation", "blocked"] },
        "fact_type": { "type": "string" },
        "fact_payload": { "type": "object" },
        "display_text": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "PendingConfirmationListResponse": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/definitions/PendingConfirmationItem" } }
      }
    },
    "ManualConfirmationReviewRequest": {
      "type": "object",
      "required": ["governance_id", "governance_status", "review_action"],
      "properties": {
        "governance_id": { "type": "string" },
        "governance_status": { "type": "string", "enum": ["auto_pass", "needs_completion", "needs_confirmation", "blocked"] },
        "review_action": { "type": "string", "enum": ["confirm", "return_for_completion", "reject"] },
        "pending_id": { "type": "string", "description": "Pending confirmation item ID" },
        "required_permission": { "type": "string" },
        "confirmed_by": { "type": "string" }
      }
    },
    "ManualConfirmationReviewResponse": {
      "type": "object",
      "required": ["review_id", "governance_id", "review_status", "policy_decision", "message"],
      "properties": {
        "review_id": { "type": "string" },
        "governance_id": { "type": "string" },
        "review_status": { "type": "string", "enum": ["confirmed_candidate", "returned_for_completion", "rejected_candidate"] },
        "policy_decision": { "type": "string", "const": "manual_review_required" },
        "message": { "type": "string" },
        "project_asset": { "type": "object" }
      }
    }
  }
}
