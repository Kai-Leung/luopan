{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "S2GovernanceGate",
  "description": "Governance check gate between L1 candidate and manual confirmation",
  "definitions": {
    "S2GovernanceCheckRequest": {
      "type": "object",
      "required": [
        "candidate_id",
        "candidate_status",
        "candidate_payload"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "input_session_id": {
          "type": "string"
        },
        "candidate_status": {
          "type": "string"
        },
        "candidate_payload": {
          "type": "object"
        }
      }
    },
    "S2GovernanceCheckResponse": {
      "type": "object",
      "required": [
        "governance_id",
        "candidate_id",
        "governance_status",
        "missing_fields",
        "risk_level",
        "question_prompts",
        "validation_hints",
        "risk_hints",
        "next_action",
        "message"
      ],
      "properties": {
        "governance_id": {
          "type": "string"
        },
        "candidate_id": {
          "type": "string"
        },
        "input_session_id": {
          "type": "string"
        },
        "governance_status": {
          "type": "string",
          "enum": [
            "auto_pass",
            "needs_completion",
            "needs_confirmation",
            "blocked"
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "blocking"
          ]
        },
        "question_prompts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_permission": {
          "type": "string"
        },
        "next_action": {
          "type": "string",
          "enum": [
            "ask_more",
            "need_confirm",
            "blocked",
            "ready_to_chain"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}