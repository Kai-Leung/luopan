{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "L0Input",
  "description": "Raw input layer - first entry point for manual input",
  "definitions": {
    "RawInputCreate": {
      "type": "object",
      "required": [
        "source_type"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "image_ref": {
          "type": "string"
        },
        "file_ref": {
          "type": "string"
        },
        "input_session_id": {
          "type": "string"
        },
        "source_type": {
          "type": "string",
          "description": "Source type enum value"
        }
      }
    },
    "RawInputReceived": {
      "type": "object",
      "required": [
        "raw_input_id",
        "input_session_id",
        "status",
        "message"
      ],
      "properties": {
        "raw_input_id": {
          "type": "string"
        },
        "input_session_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "received_only"
        },
        "message": {
          "type": "string",
          "const": "raw input received"
        }
      }
    }
  }
}