{
  "name": "compass-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/h5",
    "apps/pc",
    "apps/mobile-shell",
    "packages/*"
  ],
  "scripts": {
    "check:h5": "npm run check --workspace @compass/h5",
    "check:pc": "npm run check --workspace @compass/pc",
    "check:contracts": "python3 scripts/check/contracts_consistency.py",
    "check:frontend": "npm run check:h5 && npm run check:pc",
    "check": "npm run check:frontend && npm run check:contracts",
    "build": "echo \"Use app-specific build scripts\"",
    "test": "echo \"Use app-specific test scripts\""
  }
}
